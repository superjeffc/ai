{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "strict": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types/experimental"]
  },
  "include": ["src/**/*", "worker-configuration.d.ts"]
}
