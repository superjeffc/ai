{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "kv_namespaces": [
    {
      "binding": "USER_SESSIONS_KV",
      "id": "b5993f081e5d427ba7bc4880b3036c16"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ai_search": [
    {
      "binding": "SITE_SEARCH",
      "instance_name": "superjeffc-search"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "earnings_db",
      "database_id": "d1569062-5e33-4041-a39a-527045b07f8b"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SEC_QUEUE",
        "queue": "sec-ingestion-queue"
      }
    ],
    "consumers": [
      {
        "queue": "sec-ingestion-queue",
        "max_batch_size": 1,
        "max_concurrency": 1
      }
    ]
  }
}
